// AI-Powered Tutoring Platform (Live) — Prisma schema
// SQLite is used as the local-first store. Every interaction in a live
// tutoring session is persisted as a SessionEvent row so the timeline +
// replay UI can reconstruct the exact sequence of tutor / student / AI moves.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Static catalog of subjects offered on the platform. `topics` is a
// JSON-stringified string[] (SQLite has no native array type) and is
// surfaced to the "New session" dialog as suggested topic chips.
model Subject {
  id     String @id @default(cuid())
  name   String @unique
  label  String
  topics String
}

// A live tutoring session scoped to a subject + topic + difficulty + student.
model Session {
  id           String    @id @default(cuid())
  subjectId    String
  subject      Subject   @relation(fields: [subjectId], references: [id])
  topic        String
  difficulty   String    @default("intermediate")
  studentLevel String    @default("high-school")
  tutorName    String    @default("Tutor")
  studentName  String    @default("Student")
  status       String    @default("active")
  summary      String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  events       SessionEvent[]

  @@index([subjectId])
}

// Every discrete interaction in a session — a tutor concept, an AI
// suggestion, a generated problem, a student answer, an AI evaluation, a
// summary — is one row. `ordinal` preserves the global order; `type` drives
// the timeline badge + replay step label; `content` is the human-readable
// payload; `metadata` carries any extra JSON (e.g. correctness enum).
model SessionEvent {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ordinal   Int
  type      String
  content   String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([sessionId])
}
