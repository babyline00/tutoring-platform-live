# Prisma database URL — absolute path so the SQLite file lives inside the
# project directory (NOT the parent sandbox root). This keeps DB isolation
# per project when multiple apps share the same sandbox.
DATABASE_URL=file:/home/z/my-project/apps/109-tutoring-platform-live/db/custom.db

# --- Optional LLM configuration (z-ai-web-dev-sdk) ---
# If unset, the app falls back to a deterministic mock provider so the UI and
# tests stay demoable offline. Set these to enable real LLM completions.
# ZAI_API_KEY=your-key
# ZAI_BASE_URL=https://api.example.com/v1
# ZAI_CHAT_ID=optional
# ZAI_USER_ID=optional

# Disable LLM and force the mock provider everywhere (useful for CI).
# PKC_DISABLE_LLM=1
